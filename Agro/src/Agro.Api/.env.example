# Copia este archivo como .env y pon los datos de tu contenedor de PostgreSQL.
# El archivo .env NO se sube al repositorio.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=agro_db
DB_USER=postgres
DB_PASSWORD=cambia_esta_contrasena

# Origen(es) del frontend permitidos por CORS, separados por coma
FRONTEND_URL=http://localhost:5173