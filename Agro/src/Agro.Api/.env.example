# Copia este archivo como .env y pon los datos de tu base de datos.
# El archivo .env NO se sube al repositorio.

# --- Local (contenedor Docker) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agro_db
DB_USER=postgres
DB_PASSWORD=cambia_esta_contrasena
# DB_SSLMODE no hace falta en local (se usa Prefer)

# --- Azure (descomenta y usa estas en lugar de las de arriba) ---
# DB_HOST=agropwa-db-2.postgres.database.azure.com
# DB_USER=agro_app
# DB_PASSWORD=contrasena_de_agro_app
# DB_SSLMODE=Require

# Origen(es) del frontend permitidos por CORS, separados por coma
FRONTEND_URL=http://localhost:5173


# Almacenamiento de fotos: en local Azurite (docker), en Azure la cadena de conexión de la cuenta
STORAGE_CONEXION=UseDevelopmentStorage=true
STORAGE_CONTENEDOR=fotografias

# JWT (HU-10): clave de 32 caracteres o más; genera una propia, nunca la subas
JWT_CLAVE=genera_una_clave_aleatoria_de_32_o_mas_caracteres
JWT_EMISOR=agro-api
JWT_AUDIENCIA=agro-pwa
JWT_MINUTOS=20


# Correo (HU-27). Sin SMTP_HOST, el enlace de recuperación se escribe en la consola de la API.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PUERTO=587 y una "contraseña de aplicación" (no la de la cuenta).
# SMTP_HOST=smtp.gmail.com
# SMTP_PUERTO=587
# SMTP_USUARIO=
# SMTP_CONTRASENA=
# SMTP_REMITENTE=
URL_RESTABLECER=http://localhost:5173/restablecer
URL_VERIFICAR_CORREO=http://localhost:5173/verificar-correo