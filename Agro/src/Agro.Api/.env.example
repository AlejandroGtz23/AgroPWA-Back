# Copia este archivo como .env y pon los datos de tu base de datos.
# El archivo .env NO se sube al repositorio.

# --- Local (contenedor Docker) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agro_db
DB_USER=postgres
DB_PASSWORD=cambia_esta_contrasena
# DB_SSLMODE no hace falta en local (se usa Prefer)

# --- Azure (descomenta y usa estas en lugar de las de arriba) ---
# DB_HOST=agropwa-db-2.postgres.database.azure.com
# DB_USER=agro_app
# DB_PASSWORD=contrasena_de_agro_app
# DB_SSLMODE=Require

# Origen(es) del frontend permitidos por CORS, separados por coma
FRONTEND_URL=http://localhost:5173

# JWT (HU-10): clave de 32 caracteres o más; genera una propia, nunca la subas
JWT_CLAVE=genera_una_clave_aleatoria_de_32_o_mas_caracteres
JWT_EMISOR=agro-api
JWT_AUDIENCIA=agro-pwa
JWT_MINUTOS=20